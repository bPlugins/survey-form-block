{
  "name": "survey-form-block",
  "version": "1.1.0",
  "description": "Description of survey block.",
  "license": "GPL-2.0-or-later",
  "main": "build/index.js",
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "check-engines": "wp-scripts check-engines",
    "check-licenses": "wp-scripts check-licenses",
    "format": "wp-scripts format",
    "lint:css": "wp-scripts lint-style",
    "lint:js": "wp-scripts lint-js",
    "lint:md:docs": "wp-scripts lint-md-docs",
    "lint:pkg-json": "wp-scripts lint-pkg-json",
    "packages-update": "wp-scripts packages-update",
    "plugin-zip": "wp-scripts plugin-zip",
    "test:e2e": "wp-scripts test-e2e",
    "test:unit": "wp-scripts test-unit-js",
    "i18n-pot": "wp i18n make-pot . languages/survey-form-block.pot --exclude=\"node_modules,build,assets\" && cp ./languages/survey-form-block.pot",
    "i18n-json": "wp i18n make-json languages/ --no-purge",
    "i18n-mo": "wp i18n make-mo languages/",
    "i18n": "npm run i18n-pot && npm run i18n-json && npm run i18n-mo",
    "bundle": "wp-scripts build && npm run i18n && gulp bundle && gulp plugin_zip"
  },
  "dependencies": {
    "immer": "^9.0.17",
    "install": "^0.13.0",
    "uuidv4": "^6.2.13",
    "react-router-dom": "^7.9.3"
  },
  "devDependencies": {
    "@wordpress/scripts": "^27.9.0",
    "eslint-webpack-plugin": "^4.2.0"
  }
}
